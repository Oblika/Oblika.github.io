---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import '../styles/global.css';

const posts = (await getCollection('writeups')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const featuredPool = posts.filter(p=>p.data.featured);
const featured = (featuredPool.length ? featuredPool : posts).slice(0,3);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Samuel Oblika | Penetration Tester & Red Team">
  <Navbar />
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <div class="availability"><span></span> Open to offensive security opportunities</div>
          <p class="overline">Penetration Tester / Red Team</p>
          <h1>Curiosity is the first<br/><span>Exploit</span></h1>
          <p class="hero-lead">I'm Samuel Oblika, passionate about Offensive Security and continuously
		building skills across Active Directory, Web application Security,
		WiFi Security and Blue Team operations.</p>
          <div class="actions">
            <a class="btn primary" href={`${base}writeups/`}>View writeups</a>
            <a class="btn" href="https://www.linkedin.com/in/samueloblika/" target="_blank" rel="noreferrer">LinkedIn</a>
          </div>
        </div>

        <aside class="profile-card">
          <div class="profile-top">
            <div class="avatar">SO</div>
            <div><strong>Samuel Oblika</strong><span>Offensive Security</span></div>
          </div>
          <div class="profile-list">
            <div><span>Focus</span><strong>Penetration Testing</strong></div>
            <div><span>Specialty</span><strong>Curiosity</strong></div>
            <div><span>Location</span><strong>Albania</strong></div>
            <div><span>Status</span><strong class="status-text">Available</strong></div>
          </div>
        </aside>
      </div>
    </section>

    <section class="metrics">
      <div class="container metric-grid">
        <div><strong>CPTS Path</strong><span>Penetration Testing</span></div>
        <div><strong>CWES Path</strong><span>Web Security</span></div>
        <div><strong>CRTO (In Progres)</strong><span>Red Team</span></div>
        <div><strong>GitHub</strong><span>Methodology and projects</span></div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <div><p class="overline">Focus areas</p><h2>What I work on</h2></div>
          <p>Practical offensive security with an emphasis on repeatable methodology, clean notes and realistic lab work.</p>
        </div>
        <div class="focus-grid">
          <article><span>01</span><h3>Active Directory</h3><p>Kerberos, ACLs, ADCS, delegation, BloodHound and lateral movement.</p></article>
          <article><span>02</span><h3>Web Security</h3><p>Authentication, access control, SSRF, file upload, injection and application logic.</p></article>
          <article><span>03</span><h3>Red Team Tradecraft</h3><p>Pivoting, tunnelling, credential access and post-exploitation workflows.</p></article>
          <article><span>04</span><h3>Wireless Security</h3><p>802.11 reconnaissance, WPA/WPA2 testing and controlled WiFi labs.</p></article>
        </div>
      </div>
    </section>

    <section class="section section-muted">
      <div class="container">
        <div class="section-heading">
          <div><p class="overline">Latest writeups</p><h2>Recent technical notes</h2></div>
          <a class="quiet-link" href={`${base}writeups/`}>View all writeups</a>
        </div>
        <div class="writeup-grid">
          {featured.map(post => <a class="card" href={`${base}writeups/${post.id}/`}>
            <div class="card-meta"><span>{post.data.category}</span><span>{post.data.difficulty ?? 'Lab'}</span></div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="tags">{post.data.tags.slice(0,4).map(t=><span class="tag">{t}</span>)}</div>
            <footer><span>{post.data.date.toISOString().slice(0,10)}</span><span>{post.data.readingTime ?? '8 min'}</span></footer>
          </a>)}
        </div>
      </div>
    </section>

    <section class="section" id="about">
      <div class="container about-grid">
        <div>
          <p class="overline">About</p>
          <h2>Building a public record of practical security work.</h2>
        </div>
        <div>
          <p class="about-copy">I use this site as a technical portfolio and knowledge base. It contains lab writeups, research notes and methodology focused on offensive security. The goal is simple: show the work clearly, keep the material organized and make every project easy to revisit.</p>
          <div class="cert-row"><span>CPTS</span><span>CWES</span><span>CRTA</span><span>CRTO Training</span></div>
          <div class="profile-actions"><a href="https://github.com/Oblika" target="_blank" rel="noreferrer">GitHub</a><a href="https://www.linkedin.com/in/samueloblika/" target="_blank" rel="noreferrer">LinkedIn</a><a href={`${base}contact/`}>Contact</a></div>
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="container cta-inner">
        <div><p class="overline">Portfolio</p><h2>See the methodology behind the work.</h2></div>
        <a class="btn primary" href={`${base}writeups/`}>Explore writeups</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
