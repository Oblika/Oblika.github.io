---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="About | Samuel Oblika">
  <Navbar />
  <main class="contact-page">
    <div class="container narrow">
      <p class="overline">About</p>
      <h1>Building a public record of practical security work.</h1>
      <p class="page-lead">I'm Samuel Oblika, focused on offensive security, penetration testing and red team tradecraft. I use this site as a technical portfolio and knowledge base for authorised labs, research notes and repeatable methodology.</p>

      <div class="section-heading" style="margin-top:44px">
        <div><p class="overline">Focus areas</p><h2>What I work on</h2></div>
      </div>

      <div class="focus-grid">
        <article><span>01</span><h3>Active Directory</h3><p>Kerberos, ACLs, ADCS, delegation, BloodHound and lateral movement.</p></article>
        <article><span>02</span><h3>Web Security</h3><p>Authentication, access control, SSRF, file upload, injection and application logic.</p></article>
        <article><span>03</span><h3>Red Team Tradecraft</h3><p>Pivoting, tunnelling, credential access and post-exploitation workflows.</p></article>
        <article><span>04</span><h3>Wireless Security</h3><p>802.11 reconnaissance, WPA/WPA2 testing and controlled WiFi labs.</p></article>
      </div>

      <div class="profile-actions" style="margin-top:36px">
        <a href={`${base}writeups/`}>Writeups</a>
        <a href="https://github.com/Oblika" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/samueloblika/" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href={`${base}contact/`}>Contact</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
