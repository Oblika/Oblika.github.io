---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Samuel Oblika | Offensive Security",
  description = "Samuel Oblika - penetration testing, red team, security research and technical writeups."
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
